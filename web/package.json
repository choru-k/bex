{
  "name": "@bex/web-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/core.test.mjs tests/coaching-quality.test.mjs tests/native-smoke.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
