#!/bin/sh

SCRIPT_PATH="$0"

case "$SCRIPT_PATH" in
  */*)
    ;;
  *)
    RESOLVED_FROM_PATH="$(command -v "$SCRIPT_PATH" 2>/dev/null || true)"
    if [ -n "$RESOLVED_FROM_PATH" ]; then
      SCRIPT_PATH="$RESOLVED_FROM_PATH"
    fi
    ;;
esac

while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*)
      SCRIPT_PATH="$LINK_TARGET"
      ;;
    *)
      SCRIPT_PATH="$(dirname -- "$SCRIPT_PATH")/$LINK_TARGET"
      ;;
  esac
done

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
CLI_JS="$SCRIPT_DIR/bex-cli/index.js"

if [ ! -f "$CLI_JS" ]; then
  echo "Error: Bundled Bex CLI script not found: $CLI_JS" >&2
  echo "Try reinstalling Bex." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js is required for the bundled Bex CLI." >&2
  echo "Install with: brew install node" >&2
  exit 1
fi

exec node "$CLI_JS" "$@"
