{
  "name": "@bex/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bex": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --noEmit",
    "bex": "node dist/index.js"
  },
  "dependencies": {
    "@bex/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.8.10",
    "esbuild": "^0.25.12",
    "typescript": "^5.4"
  }
}
